{
  "functions": {
    "api/product-preview.ts": {
      "includeFiles": "dist/index.html"
    },
    "api/seo-handler.ts": {
      "includeFiles": "dist/index.html"
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "technovalearning.com"
        }
      ],
      "destination": "https://www.technovalearning.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/(about|formations|cours|blog|actualites|store|boutique|terms|privacy|legal|refund-policy)/?",
      "destination": "/api/seo-handler"
    },
    {
      "source": "/product/:productId",
      "destination": "/api/product-preview?productId=:productId"
    },
    {
      "source": "/store/:slug/:productId",
      "destination": "/api/product-preview?productId=:productId&slug=:slug"
    },
    {
      "source": "/:productId([a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})",
      "destination": "/api/product-preview?productId=:productId"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
