VITE_SUPABASE_URL=https://ton-projet.supabase.co
VITE_SUPABASE_ANON_KEY=ta_cle_anonyme_publique
NEWSDATA_API_KEY=ta_cle_api_newsdata_io

# ─────────────────────────────────────────────────────────────────────────────
# Paiements (fonctions serveur Vercel : api/payment.ts, api/webhook.ts)
# À renseigner dans Vercel → Project → Settings → Environment Variables
# (et dans .env.local pour tester en local). Ne JAMAIS préfixer ces clés par VITE_.
# ─────────────────────────────────────────────────────────────────────────────

# Clé service_role Supabase (création / validation des commandes côté serveur)
SUPABASE_SERVICE_ROLE_KEY=ta_cle_service_role
# URL publique du site (pour les URL de retour après paiement)
SITE_URL=https://www.technovalearning.com

# Passerelle prioritaire : feexpay (par défaut) ou nyole.
# Si FeexPay échoue ou n'est pas configuré, le paiement bascule automatiquement sur Nyole.
PAYMENT_PRIMARY_PROVIDER=feexpay

# --- FeexPay (https://app-v2.feexpay.me → menu Développeurs) ---
FEEXPAY_ENABLED=true
# live (production) ou sandbox (tests : https://sandbox-app.feexpay.me, clé test_key_…)
FEEXPAY_MODE=live
# Clé API privée (fp_… en production, test_key_… en sandbox)
FEEXPAY_API_KEY=fp_ta_cle_api
# Identifiant de la boutique (Shop ID)
FEEXPAY_SHOP_ID=ton_shop_id
# Secret du webhook : génère-le avec `openssl rand -hex 32`, puis configure dans
# FeexPay → Webhook l'URL : https://www.technovalearning.com/api/webhook?provider=feexpay&secret=<ce_secret>
FEEXPAY_WEBHOOK_SECRET=un_long_secret_aleatoire
# Optionnel : restreindre les réseaux actifs (vide = tous). Ex. : mtn,moov,celtiis_bj,mtn_ci,wave_ci
FEEXPAY_NETWORKS=
# Optionnel : forcer l'URL de l'API (par défaut selon FEEXPAY_MODE)
# FEEXPAY_BASE_URL=https://api-v2.feexpay.me

# --- Nyole (passerelle de secours) ---
NYOLE_ENABLED=true
NYOLE_API_KEY=ta_cle_api_nyole
NYOLE_WEBHOOK_SECRET=ton_secret_webhook_nyole
# NYOLE_BASE_URL=https://app.nyole.com/api/v1
